# Secrets read by the backend functions through secrets.get() (base44:runtime).
# Load them into the app with: npx base44 secrets set --env-file .env
ELEVENLABS_API_KEY=
# Voice used by the caller. Pick a Spanish (Mexico) voice from the ElevenLabs voice library.
# Current choice: lRf3yb6jZby4fn3q3Q7M ("Tony - Witty, Upbeat and Engaging", male, Mexican).
ELEVENLABS_VOICE_ID=
# Optional. 0.5 (default) keeps the same accent from card to card; 0.0 is more theatrical
# but drifts between generations; 1.0 is the steadiest. eleven_v3 only accepts 0, 0.5 or 1.
# ELEVENLABS_STABILITY=0.5
# Optional. Model for every card and the live voice. eleven_v3 (default) is the one approved by ear;
# eleven_v4 is newer and also understands [shouts]. On the Starter plan mp3_44100_128 is the best
# MP3 the API allows (192 kbps needs Creator, PCM needs Pro), so quality is decided by the model.
# ELEVENLABS_MODEL=eleven_v3
FIRECRAWL_API_KEY=
# Optional. With a key, local dev (npx base44 dev) generates with OpenAI instead of the mock:
# gpt-4.1-mini for the card texts, gpt-image-1 for the images, gpt-4o-mini-tts as the voice fallback.
# In production the default stays base44; set LOTERIA_PROVIDER=openai to switch.
OPENAI_API_KEY=
# OPENAI_IMAGE_QUALITY=low      # low (default, cheap, for tests) | medium | high (for the real deck)
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_TEXT_MODEL=gpt-4.1-mini
# OPENAI_TTS_VOICE=onyx
# Optional: "base44", "openai" or "mock" (offline: fixed cards, SVG placeholders, WAV beeps).
# Normally not needed: on localhost (npx base44 dev) the provider is openai with a key, else mock.
# To force it, put LOTERIA_PROVIDER=mock in .env.local (read by local dev, gitignored, never pushed by secrets set).
# LOTERIA_PROVIDER=
